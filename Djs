			function Elements:AddSlider(SliderConfig)
				SliderConfig = SliderConfig or {}
				SliderConfig.Name = SliderConfig.Name or "Slider"
				SliderConfig.Min = SliderConfig.Min or 0
				SliderConfig.Max = SliderConfig.Max or 100
				SliderConfig.Increment = SliderConfig.Increment or 1
				SliderConfig.Default = SliderConfig.Default or 50
				SliderConfig.Callback = SliderConfig.Callback or function() end
				SliderConfig.ValueName = SliderConfig.ValueName or ""
				SliderConfig.Flag = SliderConfig.Flag or nil
				SliderConfig.Save = SliderConfig.Save or false

				local Slider = {Value = SliderConfig.Default, Save = SliderConfig.Save}
				local Dragging = false

				local ValueLabel = SetProps(MakeElement("Label", tostring(Slider.Value) .. " " .. SliderConfig.ValueName, 11), {
					Position = UDim2.new(1, -52, 0, 0),
					Size = UDim2.new(0, 48, 0, 16),
					TextXAlignment = Enum.TextXAlignment.Right,
					TextColor3 = Color3.fromRGB(140, 140, 155)
				})

				-- Blue fill bar
				local SliderDrag = SetProps(MakeElement("RoundFrame", Color3.fromRGB(110, 150, 255), 0, 4), {
					Size = UDim2.new(0, 0, 1, 0)
				})

				-- Circular thumb knob at the right edge of the fill
				local SliderThumb = Create("Frame", {
					Size = UDim2.new(0, 12, 0, 12),
					Position = UDim2.new(1, -6, 0.5, -6),
					BackgroundColor3 = Color3.fromRGB(235, 235, 245),
					BorderSizePixel = 0,
					ZIndex = 4,
					Parent = SliderDrag
				})
				Create("UICorner", {CornerRadius = UDim.new(1, 0)}).Parent = SliderThumb
				Create("UIStroke", {
					Color = Color3.fromRGB(80, 115, 210),
					Thickness = 1.5
				}).Parent = SliderThumb

				local SliderBar = SetChildren(SetProps(MakeElement("RoundFrame", Color3.fromRGB(35, 35, 45), 0, 4), {
					Size = UDim2.new(1, -10, 0, 8),
					Position = UDim2.new(0, 5, 0, 20)
				}), {
					SliderDrag
				})

				local SliderFrame = SetChildren(SetProps(MakeElement("TFrame"), {
					Size = UDim2.new(1, 0, 0, 32),
					Parent = ItemParent
				}), {
					SetProps(MakeElement("Label", SliderConfig.Name, 12), {
						Position = UDim2.new(0, 5, 0, 0),
						Name = "Content"
					}),
					ValueLabel,
					SliderBar
				})

				function Slider:Set(Value)
					self.Value = math.clamp(Round(Value, SliderConfig.Increment), SliderConfig.Min, SliderConfig.Max)
					TweenService:Create(SliderDrag, TweenInfo.new(0.15), {
						Size = UDim2.fromScale(
							(self.Value - SliderConfig.Min) / (SliderConfig.Max - SliderConfig.Min), 1
						)
					}):Play()
					ValueLabel.Text = tostring(self.Value) .. " " .. SliderConfig.ValueName
					SliderConfig.Callback(self.Value)
					SaveCfg(game.GameId)
				end

				SliderBar.InputBegan:Connect(function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = true end
				end)
				SliderBar.InputEnded:Connect(function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
				end)
				UserInputService.InputChanged:Connect(function(Input)
					if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
						local Scale = math.clamp(
							(Input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X,
							0, 1
						)
						Slider:Set(SliderConfig.Min + ((SliderConfig.Max - SliderConfig.Min) * Scale))
					end
				end)

				Slider:Set(Slider.Value)
				if SliderConfig.Flag then OrionLib.Flags[SliderConfig.Flag] = Slider end
				return Slider
			end

