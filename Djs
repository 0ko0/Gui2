function OrionLib:EnableSearch(SearchInput, ItemContainer)
	SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
		local Query = string.lower(SearchInput.Text)
		for _, Column in pairs(ItemContainer:GetChildren()) do
			if Column:IsA("ScrollingFrame") or Column:IsA("Frame") then
				for _, Card in pairs(Column:GetChildren()) do
					if Card:IsA("Frame") and Card:FindFirstChild("Holder") then
						local CardHasMatch = false
						for _, Element in pairs(Card.Holder:GetChildren()) do
							if Element:FindFirstChild("Content") then
								local Text = string.lower(Element.Content.Text)
								if string.find(Text, Query) then
									Element.Visible = true
									CardHasMatch = true
								else
									Element.Visible = false
								end
							end
						end
						Card.Visible = (Query == "" or CardHasMatch)
					end
				end
			end
		end
	end)
end

function OrionLib:Init()
	if OrionLib.SaveCfg then
		pcall(function()
			if isfile(OrionLib.Folder .. "/" .. game.GameId .. ".txt") then
				LoadCfg(readfile(OrionLib.Folder .. "/" .. game.GameId .. ".txt"))
			end
		end)
	end
end

