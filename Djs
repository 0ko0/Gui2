			local CardDivider = SetProps(MakeElement("Frame", Color3.fromRGB(45, 45, 55)), {
				Position = UDim2.new(0, 0, 0, 30),
				Size = UDim2.new(1, 0, 0, 1)
			})

			-- Holder for stacked elements (starts below the divider)
			local CardHolder = SetChildren(SetProps(MakeElement("TFrame"), {
				Size = UDim2.new(1, -16, 0, 0),
				Position = UDim2.new(0, 8, 0, 36),
				AutomaticSize = Enum.AutomaticSize.Y,
				Name = "Holder"
			}), {
				MakeElement("List", 0, 6),
				MakeElement("Padding", 6, 0, 0, 0)
			})

			local CardFrame = SetChildren(SetProps(MakeElement("RoundFrame", Color3.fromRGB(22, 22, 28), 0, 8), {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = TargetColumn
			}), {
				MakeElement("Stroke", Color3.fromRGB(45, 45, 55), 1),
				CardTitle,
				CardDivider,
				CardHolder
			})

			return GetElements(CardHolder)
		end

		function ElementFunction:AddSection(SectionConfig)
			return ElementFunction:AddCard({Name = SectionConfig.Name or "Section", Side = "Left"})
		end

		return ElementFunction
	end

	return TabFunction
end

function OrionLib:Destroy()
	Orion:Destroy()
end

return OrionLib
