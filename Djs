					end
					for _, Option in pairs(Dropdown.Options) do
						local Btn = SetChildren(SetProps(MakeElement("Button"), {
							Size = UDim2.new(1, 0, 0, 20),
							Parent = ListContainer
						}), {
							SetProps(MakeElement("Label", Option, 11), {Position = UDim2.new(0, 5, 0, 0)})
						})
						Btn.MouseEnter:Connect(function()
							TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundTransparency = 0.85}):Play()
						end)
						Btn.MouseLeave:Connect(function()
							TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundTransparency = 1}):Play()
						end)
						Btn.BackgroundColor3 = Color3.fromRGB(110, 150, 255)
						Btn.BackgroundTransparency = 1
						Btn.MouseButton1Click:Connect(function()
							Dropdown.Value = Option
							SelectedLabel.Text = Option
							DropdownConfig.Callback(Option)
							Dropdown.Toggled = false
							ChevronLabel.Text = "v"
							TweenService:Create(DropdownFrame, TweenInfo.new(0.2), {
								Size = UDim2.new(1, 0, 0, 26)
							}):Play()
						end)
					end
				end

				Click.MouseButton1Click:Connect(function()
					Dropdown.Toggled = not Dropdown.Toggled
					ChevronLabel.Text = Dropdown.Toggled and "^" or "v"
					local Height = Dropdown.Toggled and (28 + (#Dropdown.Options * 22)) or 26
					TweenService:Create(DropdownFrame, TweenInfo.new(0.2), {
						Size = UDim2.new(1, 0, 0, Height)
					}):Play()
				end)

				RefreshOptions()
				if DropdownConfig.Flag then OrionLib.Flags[DropdownConfig.Flag] = Dropdown end
				return Dropdown
			end

