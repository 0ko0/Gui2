	-- ============ WINDOW METHODS ============
	function Window:Notify(opts) Notify(opts) end

	function Window:CreateDialog(opts)
		opts = opts or {}
		local DTitle = opts.Title or "Confirm"
		local DContent = opts.Content or ""
		local Buttons = opts.Buttons or {
			{ Text = "OK", Primary = true, Callback = function() end },
		}

		local Overlay = Create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 100,
			Parent = ScreenGui,
		})

		local Dialog = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0, 0, 0, 0),
			BackgroundColor3 = Theme.Background,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 101,
			Parent = Overlay,
		})
		AddCorner(Dialog, 12)
		AddStroke(Dialog, Theme.Border, 1, 0.3)
		AddShadow(Dialog, 40, 0.5)

		Create("TextLabel", {
			Position = UDim2.new(0, 24, 0, 22),
			Size = UDim2.new(1, -48, 0, 22),
			BackgroundTransparency = 1,
			Font = FontBold,
			Text = DTitle,
			TextSize = 16,
			TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 102,
			Parent = Dialog,
		})

		Create("TextLabel", {
			Position = UDim2.new(0, 24, 0, 52),
			Size = UDim2.new(1, -48, 0, 60),
			BackgroundTransparency = 1,
			Font = FontRegular,
			Text = DContent,
			TextSize = 13,
			TextColor3 = Theme.SubText,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 102,
			Parent = Dialog,
		})

		local BtnRow = Create("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 24, 1, -20),
			Size = UDim2.new(1, -48, 0, 36),
			BackgroundTransparency = 1,
			ZIndex = 102,
			Parent = Dialog,
		})
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = BtnRow,
		})

		local function Close()
			Tween(Overlay, { BackgroundTransparency = 1 }, 0.2)
			Tween(Dialog, { Size = UDim2.new(0, 0, 0, 0) }, 0.2)
			task.delay(0.25, function() Overlay:Destroy() end)
		end

		for _, b in ipairs(Buttons) do
			local Btn = Create("TextButton", {
				Size = UDim2.new(0, 100, 1, 0),
				BackgroundColor3 = b.Primary and Theme.Accent or Theme.Surface,
				BackgroundTransparency = b.Primary and 0 or 0,
				AutoButtonColor = false,
				Font = FontSemibold,
				Text = b.Text or "OK",
				TextSize = 13,
				TextColor3 = b.Primary and Color3.new(1, 1, 1) or Theme.Text,
				ZIndex = 103,
				Parent = BtnRow,
			})
			AddCorner(Btn, 8)
			if not b.Primary then AddStroke(Btn, Theme.Border, 1, 0.3) end

			Btn.MouseEnter:Connect(function()
				Tween(Btn, { BackgroundColor3 = b.Primary and Theme.AccentHover or Theme.SurfaceHover }, 0.15)
			end)
			Btn.MouseLeave:Connect(function()
				Tween(Btn, { BackgroundColor3 = b.Primary and Theme.Accent or Theme.Surface }, 0.15)
			end)
			Btn.MouseButton1Click:Connect(function()
				Close()
				SafeCallback(b.Callback)
			end)
		end

		Tween(Overlay, { BackgroundTransparency = 0.4 }, 0.2)
		Spring(Dialog, { Size = UDim2.new(0, 340, 0, 180) }, 0.4)

		return { Close = Close }
	end

	function Window:GetFlags()
		local r = {}
		for k, v in pairs(Flags) do r[k] = v.Get() end
		return r
	end

	function Window:SetFlags(data)
		for k, v in pairs(data or {}) do
			if Flags[k] and Flags[k].Set then Flags[k].Set(v) end
		end
	end

	function Window:SaveConfig(name)
		local success, encoded = pcall(HttpService.JSONEncode, HttpService, self:GetFlags())
		if success and writefile then
			pcall(writefile, "AuroraUI_" .. name .. ".json", encoded)
			Notify({ Title = "Config Saved", Content = "Saved as " .. name, Type = "Success" })
		end
	end

	function Window:LoadConfig(name)
		if readfile and isfile and isfile("AuroraUI_" .. name .. ".json") then
			local success, data = pcall(function()
				return HttpService:JSONDecode(readfile("AuroraUI_" .. name .. ".json"))
			end)
			if success then
				self:SetFlags(data)
				Notify({ Title = "Config Loaded", Content = "Loaded " .. name, Type = "Success" })
			end
		end
	end

	function Window:Destroy() ScreenGui:Destroy() end

	function Window:SetTheme(themeName)
		local newTheme = Themes[themeName]
		if not newTheme then return end
		Theme = newTheme
		Notify({ Title = "Theme Changed", Content = "Switched to " .. themeName, Type = "Info" })
	end

	table.insert(Aurora.Windows, Window)
	return Window
end

return Aurora
