			}, {
				Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
				Create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }),
				Create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
			})

			local OptionButtons = {}

			local function UpdateOptionVisuals()
				for _, option in ipairs(Options) do
					local btn = OptionButtons[option]
					if btn then
						local sel = IsSelected(option)
						btn.BackgroundColor3 = sel and Theme.Accent or Theme.Surface
						btn.BackgroundTransparency = sel and 0 or 1
						btn.TextColor3 = sel and Color3.new(1, 1, 1) or Theme.SubText
					end
				end
			end

			local function Rebuild()
				for _, c in ipairs(ListContainer:GetChildren()) do
					if c:IsA("TextButton") then c:Destroy() end
				end
				OptionButtons = {}
				for _, option in ipairs(Options) do
					local OptBtn = Create("TextButton", {
						Size = UDim2.new(1, 0, 0, 28),
						BackgroundColor3 = Theme.Surface,
						BackgroundTransparency = 1,
						AutoButtonColor = false,
						Font = Font,
						Text = tostring(option),
						TextSize = 12,
						TextColor3 = Theme.SubText,
						Parent = ListContainer,
					}, {
						Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
					})

					OptionButtons[option] = OptBtn

					OptBtn.MouseButton1Click:Connect(function()
						if Multi then
							Selected[option] = not Selected[option]
							UpdateOptionVisuals()
							SelectedLabel.Text = GetDisplayText()
							local result = {}
							for _, opt in ipairs(Options) do
								if Selected[opt] then table.insert(result, opt) end
							end
							SafeCallback(Callback, result)
						else
							Selected = option
							SelectedLabel.Text = GetDisplayText()
							Open = false
							Tween(Holder, { Size = UDim2.new(1, 0, 0, 42) }, 0.2)
							Tween(Arrow, { Rotation = 0 }, 0.2)
							SafeCallback(Callback, Selected)
						end
					end)
				end
				UpdateOptionVisuals()
			end
			Rebuild()

			ClickArea.MouseButton1Click:Connect(function()
				Open = not Open
				local height = Open and (54 + (#Options * 30)) or 42
				Tween(Holder, { Size = UDim2.new(1, 0, 0, height) }, 0.2)
				Tween(Arrow, { Rotation = Open and 180 or 0 }, 0.2)
			end)

			return RegisterFlag(opts, {
				Set = function(v)
					if Multi then
						Selected = {}
						for _, opt in ipairs(v or {}) do Selected[opt] = true end
					else
						Selected = v
					end
					SelectedLabel.Text = GetDisplayText()
					UpdateOptionVisuals()
				end,
				Get = function()
					if Multi then
						local result = {}
						for _, opt in ipairs(Options) do
							if Selected[opt] then table.insert(result, opt) end
						end
						return result
					end
					return Selected
				end,
				Refresh = function(newOptions)
					Options = newOptions
					Rebuild()
				end,
			})
		end

