local function Create(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function Tween(obj, props, duration, style, direction)
	duration = duration or 0.2
	style = style or Enum.EasingStyle.Quad
	direction = direction or Enum.EasingDirection.Out
	local tw = TweenService:Create(obj, TweenInfo.new(duration, style, direction), props)
	tw:Play()
	return tw
end

local function CreateRow(parent, height)
	local Holder = Create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Theme.Surface,
		BackgroundTransparency = 1,
		Parent = parent,
	})

	Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Divider,
		BorderSizePixel = 0,
		Parent = Holder,
	})

	return Holder
end

local function MakeDraggable(dragHandle, target)
	local dragging = false
	local dragInput, dragStart, startPos

	dragHandle.Active = true

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = target.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	dragHandle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			local newX = startPos.X.Offset + delta.X
			local newY = startPos.Y.Offset + delta.Y

			local camera = workspace.CurrentCamera
			local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
			local marginX = math.min(60, target.AbsoluteSize.X * 0.4)
			local marginY = math.min(60, target.AbsoluteSize.Y * 0.4)

			local minX = marginX - (viewport.X * startPos.X.Scale)
			local maxX = viewport.X - marginX - (viewport.X * startPos.X.Scale)
			local minY = marginY - (viewport.Y * startPos.Y.Scale)
			local maxY = viewport.Y - marginY - (viewport.Y * startPos.Y.Scale)

			newX = math.clamp(newX, minX, maxX)
			newY = math.clamp(newY, minY, maxY)

			target.Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
		end
	end)
end

