	local function GetViewportSize()
		local camera = workspace.CurrentCamera
		if camera then
			return camera.ViewportSize
		end
		return Vector2.new(1280, 720)
	end

	local function ComputeScale()
		local viewport = GetViewportSize()
		local scaleX = (viewport.X * 0.94) / WindowSize.X.Offset
		local scaleY = (viewport.Y * 0.88) / WindowSize.Y.Offset
		local scale = math.min(scaleX, scaleY, 1)
		pcall(function()
			if GuiService:IsTenFootInterface() then
				scale = scale * 1.15
			end
		end)
		return math.clamp(scale, 0.6, 1.25)
	end

	UIScale.Scale = ComputeScale()

	local StartCamera = workspace.CurrentCamera
	if StartCamera then
		StartCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			Tween(UIScale, { Scale = ComputeScale() }, 0.25)
