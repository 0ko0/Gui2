		-- ============ SLIDER ============
		function TabObject:CreateSlider(opts)
			opts = opts or {}
			local Name = opts.Name or "Slider"
			local Min = opts.Min or 0
			local Max = opts.Max or 100
			local Decimals = opts.Decimals or 0
			local Suffix = opts.Suffix or ""
			local Value = opts.Default or Min
			local Callback = opts.Callback or function() end

			local Card = CreateCard(60)

			Create("TextLabel", {
				Position = UDim2.new(0, 16, 0, 10),
				Size = UDim2.new(1, -80, 0, 16),
				BackgroundTransparency = 1,
				Font = FontSemibold,
				Text = Name,
				TextSize = 13,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Card,
			})

			local ValuePill = Create("Frame", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -14, 0, 8),
				Size = UDim2.new(0, 60, 0, 20),
				BackgroundColor3 = Theme.Accent,
				BackgroundTransparency = 0.85,
				BorderSizePixel = 0,
				Parent = Card,
			})
			AddCorner(ValuePill, 6)

			local ValueLabel = Create("TextLabel", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				Font = FontBold,
				Text = tostring(Value) .. Suffix,
				TextSize = 11,
				TextColor3 = Theme.Accent,
				Parent = ValuePill,
			})

			local Track = Create("Frame", {
				Position = UDim2.new(0, 16, 1, -18),
				Size = UDim2.new(1, -32, 0, 4),
				BackgroundColor3 = Theme.Divider,
				BorderSizePixel = 0,
				Parent = Card,
			})
			AddCorner(Track, 999)

			local initialPct = (Max ~= Min) and math.clamp((Value - Min) / (Max - Min), 0, 1) or 0

			local Fill = Create("Frame", {
				Size = UDim2.new(initialPct, 0, 1, 0),
				BackgroundColor3 = Theme.Accent,
				BorderSizePixel = 0,
				Parent = Track,
			})
			AddCorner(Fill, 999)

			local Knob = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(initialPct, 0, 0.5, 0),
				Size = UDim2.new(0, 14, 0, 14),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 2,
				Parent = Track,
			})
			AddCorner(Knob, 999)
			AddStroke(Knob, Theme.Accent, 2)

			local HitArea = Create("TextButton", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundTransparency = 1,
				Text = "",
				Parent = Track,
			})

			local Dragging = false

			local function UpdateFromInput(input)
				local pct = 0
				if HitArea.AbsoluteSize.X > 0 then
					pct = math.clamp((input.Position.X - HitArea.AbsolutePosition.X) / HitArea.AbsoluteSize.X, 0, 1)
				end
				local raw = Min + (Max - Min) * pct
				local mult = 10 ^ Decimals
				Value = math.clamp(math.floor(raw * mult + 0.5) / mult, Min, Max)
				Fill.Size = UDim2.new(pct, 0, 1, 0)
				Knob.Position = UDim2.new(pct, 0, 0.5, 0)
				ValueLabel.Text = tostring(Value) .. Suffix
				SafeCallback(Callback, Value)
			end

			HitArea.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					Dragging = true
					Tween(Knob, { Size = UDim2.new(0, 18, 0, 18) }, 0.15)
					UpdateFromInput(input)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					UpdateFromInput(input)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					if Dragging then Tween(Knob, { Size = UDim2.new(0, 14, 0, 14) }, 0.15) end
					Dragging = false
				end
			end)

			return RegisterFlag(opts, {
				Set = function(v)
					Value = math.clamp(v, Min, Max)
					local pct = (Max ~= Min) and ((Value - Min) / (Max - Min)) or 0
					Tween(Fill, { Size = UDim2.new(pct, 0, 1, 0) }, 0.15)
					Tween(Knob, { Position = UDim2.new(pct, 0, 0.5, 0) }, 0.15)
					ValueLabel.Text = tostring(Value) .. Suffix
				end,
				Get = function() return Value end,
			})
		end

		-- ============ DROPDOWN ============
		function TabObject:CreateDropdown(opts)
			opts = opts or {}
			local Name = opts.Name or "Dropdown"
			local Options = opts.Options or {}
			local Multi = opts.Multi or false
			local Callback = opts.Callback or function() end
			local Open = false

			local Selected
			if Multi then
				Selected = {}
				for _, v in ipairs(opts.Default or {}) do Selected[v] = true end
			else
				Selected = opts.Default or Options[1]
			end

			local function IsSelected(o) return Multi and Selected[o] == true or Selected == o end
			local function GetDisplay()
				if not Multi then return Selected and tostring(Selected) or "None" end
				local list = {}
				for _, o in ipairs(Options) do if Selected[o] then table.insert(list, tostring(o)) end end
				if #list == 0 then return "None"
				elseif #list == 1 then return list[1] end
				return #list .. " selected"
			end

			local Holder = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 44),
				BackgroundTransparency = 1,
				ClipsDescendants = true,
				Parent = Page,
			})

			local Card = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 44),
