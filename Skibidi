			local Options = opts.Options or {}
			local Multi = opts.Multi or false
			local Callback = opts.Callback or function() end
			local Open = false

			local Selected
			if Multi then
				Selected = {}
				for _, v in ipairs(opts.Default or {}) do Selected[v] = true end
			else
				Selected = opts.Default or Options[1]
			end

			local function IsSelected(option)
				return Multi and (Selected[option] == true) or (Selected == option)
			end

			local function GetDisplayText()
				if not Multi then return Selected and tostring(Selected) or "None" end
				local list = {}
				for _, option in ipairs(Options) do
					if Selected[option] then table.insert(list, tostring(option)) end
				end
				if #list == 0 then return "None"
				elseif #list == 1 then return list[1] end
				return #list .. " selected"
			end

			local Holder = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 42),
				BackgroundTransparency = 1,
				ClipsDescendants = true,
				Parent = Page,
