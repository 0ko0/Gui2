local function Create(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function Tween(obj, props, duration, style, direction)
	duration = duration or 0.25
	style = style or Enum.EasingStyle.Quart
	direction = direction or Enum.EasingDirection.Out
	local tw = TweenService:Create(obj, TweenInfo.new(duration, style, direction), props)
	tw:Play()
	return tw
end

local function Spring(obj, props, duration)
	return Tween(obj, props, duration or 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

