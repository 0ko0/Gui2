			TextSize = 13,
			TextColor3 = Theme.SubText,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = DialogBox,
		})

		local ButtonRow = Create("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 20, 1, -16),
			Size = UDim2.new(1, -40, 0, 34),
			BackgroundTransparency = 1,
			Parent = DialogBox,
		}, {
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})

		local function CloseDialog()
			Tween(Overlay, { BackgroundTransparency = 1 }, 0.2)
			Tween(DialogBox, { Size = UDim2.new(0, 0, 0, 0) }, 0.2)
			task.delay(0.2, function() Overlay:Destroy() end)
		end

		for _, btnData in ipairs(Buttons) do
			local IsPrimary = btnData.Primary
			local Btn = Create("TextButton", {
				Size = UDim2.new(0, 96, 1, 0),
				BackgroundColor3 = IsPrimary and Theme.Accent or Theme.Surface,
				AutoButtonColor = false,
				Font = FontSemibold,
				Text = btnData.Text or "OK",
				TextSize = 13,
				TextColor3 = IsPrimary and Color3.new(1, 1, 1) or Theme.Text,
				Parent = ButtonRow,
			}, {
				Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
			})

			Btn.MouseButton1Click:Connect(function()
				CloseDialog()
				SafeCallback(btnData.Callback)
			end)
		end

		Tween(Overlay, { BackgroundTransparency = 0.5 }, 0.2)
		Tween(DialogBox, { Size = UDim2.new(0, 300, 0, 150) }, 0.2, Enum.EasingStyle.Quad)

		return { Close = CloseDialog }
	end

	function Window:GetFlags()
		local result = {}
		for flagName, obj in pairs(Flags) do
			result[flagName] = obj.Get()
		end
		return result
	end

	function Window:SetFlags(data)
		for flagName, value in pairs(data or {}) do
			local obj = Flags[flagName]
			if obj and obj.Set then
				obj.Set(value)
			end
		end
	end

	function Window:Destroy()
		ScreenGui:Destroy()
	end

	return Window
end

