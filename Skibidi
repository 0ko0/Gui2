				Size = UDim2.new(1, 0, 0, HeaderHeight + 40),
				BackgroundTransparency = 1,
				Parent = Page,
			})

			if Name then
				Create("TextLabel", {
					Size = UDim2.new(1, 0, 0, 16),
					BackgroundTransparency = 1,
					Font = Font,
					Text = Name,
					TextSize = 13,
					TextColor3 = Theme.SubText,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = Holder,
				})
			end

			local Row = Create("Frame", {
				Position = UDim2.new(0, 0, 0, HeaderHeight + 4),
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundColor3 = Theme.Surface,
				Parent = Holder,
			}, {
				Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
				Create("UIPadding", { PaddingLeft = UDim.new(0, 2), PaddingRight = UDim.new(0, 2), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }),
				Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
			})

			local OptionButtons = {}

			local function UpdateVisuals()
				for _, option in ipairs(Options) do
					local entry = OptionButtons[option]
					if entry then
						local sel = (option == Selected)
						Tween(entry.Frame, { BackgroundColor3 = sel and Theme.Accent or Theme.Surface }, 0.15)
						Tween(entry.Label, { TextColor3 = sel and Color3.new(1, 1, 1) or Theme.SubText }, 0.15)
					end
				end
			end

			local optionCount = math.max(#Options, 1)
			for _, option in ipairs(Options) do
				local isSel = (option == Selected)
				local Btn = Create("TextButton", {
					Size = UDim2.new(1 / optionCount, 0, 1, 0),
					BackgroundColor3 = isSel and Theme.Accent or Theme.Surface,
					AutoButtonColor = false,
					Text = "",
					Parent = Row,
				}, {
					Create("UICorner", { CornerRadius = UDim.new(0, 5) }),
				})

				local Lbl = Create("TextLabel", {
					Size = UDim2.new(1, 0, 1, 0),
					BackgroundTransparency = 1,
					Font = FontSemibold,
					Text = tostring(option),
					TextSize = 12,
					TextColor3 = isSel and Color3.new(1, 1, 1) or Theme.SubText,
					Parent = Btn,
				})

				OptionButtons[option] = { Frame = Btn, Label = Lbl }

				Btn.MouseButton1Click:Connect(function()
					if Selected == option then return end
					Selected = option
					UpdateVisuals()
					SafeCallback(Callback, Selected)
				end)
			end

			return RegisterFlag(opts, {
				Set = function(v)
					Selected = v
					UpdateVisuals()
				end,
				Get = function() return Selected end,
			})
		end

