				for _, o in ipairs(Options) do
					local b = OptionButtons[o]
					if b then
						local sel = IsSelected(o)
						Tween(b.Frame, { BackgroundColor3 = sel and Theme.Accent or Theme.Surface, BackgroundTransparency = sel and 0.7 or 1 }, 0.15)
						Tween(b.Label, { TextColor3 = sel and Theme.Accent or Theme.SubText }, 0.15)
						b.Check.Visible = sel
					end
				end
			end

			local function Rebuild()
				for _, c in ipairs(ListContainer:GetChildren()) do
					if c:IsA("TextButton") then c:Destroy() end
				end
				OptionButtons = {}
				for _, o in ipairs(Options) do
					local OptBtn = Create("TextButton", {
						Size = UDim2.new(1, 0, 0, 30),
						BackgroundColor3 = Theme.Surface,
						BackgroundTransparency = 1,
						AutoButtonColor = false,
						Text = "",
						Parent = ListContainer,
