						Position = UDim2.new(0, 12, 0, 0),
						Size = UDim2.new(1, -36, 1, 0),
						BackgroundTransparency = 1,
						Font = Font,
						Text = tostring(o),
						TextSize = 12,
						TextColor3 = Theme.SubText,
						TextXAlignment = Enum.TextXAlignment.Left,
						Parent = OptBtn,
					})

					local Check = Create("TextLabel", {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -10, 0.5, 0),
						Size = UDim2.new(0, 14, 0, 14),
						BackgroundTransparency = 1,
						Font = FontBold,
						Text = "✓",
						TextSize = 12,
						TextColor3 = Theme.Accent,
						Visible = false,
						Parent = OptBtn,
					})

					OptionButtons[o] = { Frame = OptBtn, Label = Lbl, Check = Check }

					OptBtn.MouseEnter:Connect(function()
						if not IsSelected(o) then Tween(OptBtn, { BackgroundTransparency = 0.85 }, 0.1) end
					end)
					OptBtn.MouseLeave:Connect(function()
						if not IsSelected(o) then Tween(OptBtn, { BackgroundTransparency = 1 }, 0.1) end
					end)

					OptBtn.MouseButton1Click:Connect(function()
						if Multi then
							Selected[o] = not Selected[o]
							UpdateVisuals()
							SelectedLabel.Text = GetDisplay()
							local result = {}
							for _, opt in ipairs(Options) do if Selected[opt] then table.insert(result, opt) end end
							SafeCallback(Callback, result)
						else
							Selected = o
							SelectedLabel.Text = GetDisplay()
							UpdateVisuals()
							Open = false
							Tween(Holder, { Size = UDim2.new(1, 0, 0, 44) }, 0.2)
							Tween(Arrow, { Rotation = 0 }, 0.2)
							SafeCallback(Callback, Selected)
						end
					end)
				end
				UpdateVisuals()
			end
			Rebuild()

			ClickArea.MouseButton1Click:Connect(function()
				Open = not Open
				local height = Open and (52 + math.min(#Options, 6) * 32 + 4) or 44
				Tween(Holder, { Size = UDim2.new(1, 0, 0, height) }, 0.25, Enum.EasingStyle.Quart)
				Tween(Arrow, { Rotation = Open and 180 or 0 }, 0.2)
			end)

			return RegisterFlag(opts, {
				Set = function(v)
					if Multi then
						Selected = {}
						for _, opt in ipairs(v or {}) do Selected[opt] = true end
					else Selected = v end
					SelectedLabel.Text = GetDisplay()
					UpdateVisuals()
				end,
				Get = function()
					if Multi then
						local r = {}
						for _, o in ipairs(Options) do if Selected[o] then table.insert(r, o) end end
						return r
					end
					return Selected
				end,
				Refresh = function(new) Options = new; Rebuild() end,
			})
		end

