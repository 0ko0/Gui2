		function TabObject:CreateSlider(opts)
			opts = opts or {}
			local Name = opts.Name or "Slider"
			local Min = opts.Min or 0
			local Max = opts.Max or 100
			local Decimals = opts.Decimals or 0
			local Value = opts.Default or Min
			local Callback = opts.Callback or function() end

			local Holder = CreateRow(Page, 48)

			Create("TextLabel", {
				Position = UDim2.new(0, 0, 0, 6),
				Size = UDim2.new(1, -60, 0, 16),
				BackgroundTransparency = 1,
				Font = Font,
				Text = Name,
				TextSize = 13,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Holder,
			})

			local ValueLabel = Create("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 6),
				Size = UDim2.new(0, 50, 0, 16),
				BackgroundTransparency = 1,
				Font = Font,
				Text = tostring(Value),
				TextSize = 12,
				TextColor3 = Theme.SubText,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = Holder,
			})

			local TrackVisual = Create("Frame", {
				Position = UDim2.new(0, 0, 1, -12),
				Size = UDim2.new(1, 0, 0, 3),
				BackgroundColor3 = Theme.Surface,
				Parent = Holder,
			}, {
				Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
			})

			local initialPct = (Max ~= Min) and math.clamp((Value - Min) / (Max - Min), 0, 1) or 0

			local Fill = Create("Frame", {
				Size = UDim2.new(initialPct, 0, 1, 0),
				BackgroundColor3 = Theme.Accent,
				Parent = TrackVisual,
			}, {
				Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
			})

			local Knob = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(initialPct, 0, 0.5, 0),
				Size = UDim2.new(0, 10, 0, 10),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 2,
				Parent = TrackVisual,
			}, {
				Create("UICorner", { CornerRadius = UDim.new(1, 0) }),
			})

			local HitArea = Create("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Size = UDim2.new(1, 0, 0, 24),
				BackgroundTransparency = 1,
				Active = true,
				Parent = TrackVisual,
			})

			local Dragging = false

			local function UpdateFromInput(input)
				local pct = 0
				if HitArea.AbsoluteSize.X > 0 then
					pct = math.clamp((input.Position.X - HitArea.AbsolutePosition.X) / HitArea.AbsoluteSize.X, 0, 1)
				end
				local raw = Min + (Max - Min) * pct
				local mult = 10 ^ Decimals
				local rounded = math.floor(raw * mult + 0.5) / mult
				Value = math.clamp(rounded, Min, Max)
				Fill.Size = UDim2.new(pct, 0, 1, 0)
				Knob.Position = UDim2.new(pct, 0, 0.5, 0)
				ValueLabel.Text = tostring(Value)
				SafeCallback(Callback, Value)
			end

			HitArea.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					Dragging = true
					UpdateFromInput(input)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					UpdateFromInput(input)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					Dragging = false
				end
			end)

			return RegisterFlag(opts, {
				Set = function(v)
					Value = math.clamp(v, Min, Max)
					local pct = (Max ~= Min) and ((Value - Min) / (Max - Min)) or 0
					Tween(Fill, { Size = UDim2.new(pct, 0, 1, 0) }, 0.1)
					Tween(Knob, { Position = UDim2.new(pct, 0, 0.5, 0) }, 0.1)
					ValueLabel.Text = tostring(Value)
				end,
				Get = function() return Value end,
			})
		end

		function TabObject:CreateDropdown(opts)
			opts = opts or {}
