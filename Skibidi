		-- ============ NEW: TEXTAREA ============
		function TabObject:CreateTextArea(opts)
			opts = opts or {}
			local Name = opts.Name or "Notes"
			local Placeholder = opts.Placeholder or "Type here..."
			local Default = opts.Default or ""
			local Height = opts.Height or 100
			local Callback = opts.Callback or function() end

			local Card = CreateCard(30 + Height + 12)

			Create("TextLabel", {
				Position = UDim2.new(0, 16, 0, 8),
				Size = UDim2.new(1, -32, 0, 16),
				BackgroundTransparency = 1,
				Font = FontSemibold,
				Text = Name,
				TextSize = 12,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Card,
			})

			local BoxHolder = Create("Frame", {
				Position = UDim2.new(0, 12, 0, 28),
				Size = UDim2.new(1, -24, 0, Height),
				BackgroundColor3 = Theme.BackgroundSecondary,
				BorderSizePixel = 0,
				Parent = Card,
			})
			AddCorner(BoxHolder, 7)
			local BS = AddStroke(BoxHolder, Theme.Border, 1, 0.3)
			AddPadding(BoxHolder, 8, 10, 8, 10)

			local Box = Create("TextBox", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				Font = Font,
				PlaceholderText = Placeholder,
				Text = Default,
				TextSize = 12,
				TextColor3 = Theme.Text,
				PlaceholderColor3 = Theme.Muted,
				ClearTextOnFocus = false,
				MultiLine = true,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				Parent = BoxHolder,
			})

			Box.Focused:Connect(function() Tween(BS, { Color = Theme.Accent, Transparency = 0 }, 0.15) end)
			Box.FocusLost:Connect(function(enter)
				Tween(BS, { Color = Theme.Border, Transparency = 0.3 }, 0.15)
				SafeCallback(Callback, Box.Text, enter)
			end)

			return RegisterFlag(opts, {
				Set = function(v) Box.Text = tostring(v) end,
				Get = function() return Box.Text end,
			})
		end

		-- ============ NEW: BUTTON GROUP (SIDE-BY-SIDE) ============
		function TabObject:CreateButtonGroup(opts)
			opts = opts or {}
			local Buttons = opts.Buttons or {}

			local Holder = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 40),
				BackgroundTransparency = 1,
				Parent = Page,
			})
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 8),
				SortOrder = Enum.SortOrder.LayoutOrder,
				Parent = Holder,
			})

			local count = math.max(#Buttons, 1)
			for _, b in ipairs(Buttons) do
				local isPrimary = b.Primary
				local Btn = Create("TextButton", {
					Size = UDim2.new(1 / count, -8 * (count - 1) / count, 1, 0),
					BackgroundColor3 = isPrimary and Theme.Accent or Theme.Surface,
					BackgroundTransparency = isPrimary and 0 or 0.15,
					AutoButtonColor = false,
					Font = FontSemibold,
					Text = b.Text or "Button",
					TextSize = 12,
					TextColor3 = isPrimary and Color3.new(1, 1, 1) or Theme.Text,
					Parent = Holder,
				})
				AddCorner(Btn, 8)
				if not isPrimary then AddStroke(Btn, Theme.Border, 1, 0.5) end

				Btn.MouseEnter:Connect(function()
					Tween(Btn, {
						BackgroundColor3 = isPrimary and Theme.AccentHover or Theme.SurfaceHover,
						BackgroundTransparency = isPrimary and 0 or 0,
					}, 0.15)
				end)
				Btn.MouseLeave:Connect(function()
					Tween(Btn, {
						BackgroundColor3 = isPrimary and Theme.Accent or Theme.Surface,
						BackgroundTransparency = isPrimary and 0 or 0.15,
					}, 0.15)
				end)
				Btn.MouseButton1Down:Connect(function(x, y) Ripple(Btn, x, y) end)
				Btn.MouseButton1Click:Connect(function() SafeCallback(b.Callback) end)
			end
			return Holder
		end

