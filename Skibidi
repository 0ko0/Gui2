local function GetSafeGuiParent()
	local success, result = pcall(function()
		if gethui then return gethui()
		elseif syn and syn.protect_gui then return CoreGui
		elseif CoreGui:FindFirstChild("RobloxGui") then return CoreGui
		end
	end)
	if success and result then return result end
	return Player:WaitForChild("PlayerGui")
end

local function ProtectGuiInstance(gui)
	pcall(function()
		if syn and syn.protect_gui then syn.protect_gui(gui)
		elseif protectgui then protectgui(gui) end
	end)
end

local function SafeCallback(fn, ...)
	if type(fn) == "function" then
		local args = {...}
		task.spawn(function()
			local success, err = pcall(fn, table.unpack(args))
			if not success then warn("[Aurora Callback Error]:", err) end
		end)
	end
end

